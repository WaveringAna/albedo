+// cellAttrs shares the style and link records a parse hands out. A string
+// repeats the same few styles across its cells, so a parse allocates one
+// record per style rather than per cell, and a string with no escapes
+// allocates none at all.
+type cellAttrs struct {
+	styles map[Style]*Style
+	links  map[Link]*Link
+}
+
+// style returns the shared record for style, creating it the first time this
+// parse sees it.
+func (a *cellAttrs) style(style Style) *Style {
+	if style.IsZero() {
+		return nil
+	}
+	if a.styles == nil {
+		a.styles = make(map[Style]*Style)
+	}
+	if shared, ok := a.styles[style]; ok {
+		return shared
+	}
+	shared := StyleRef(style)
+	a.styles[style] = shared
+	return shared
+}
+
+// link returns the shared record for link, like [cellAttrs.style].
+func (a *cellAttrs) link(link Link) *Link {
+	if link.IsZero() {
+		return nil
+	}
+	if a.links == nil {
+		a.links = make(map[Link]*Link)
+	}
+	if shared, ok := a.links[link]; ok {
+		return shared
+	}
+	shared := LinkRef(link)
+	a.links[link] = shared
+	return shared
+}
+
