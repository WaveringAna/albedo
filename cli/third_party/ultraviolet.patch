 // Cell represents a single cell in the terminal screen.
+//
+// A screen is a cell per column and row, so what a cell costs is what a screen
+// costs. Style and Link are therefore shared records rather than values: every
+// cell that has the same style points at the same one, and a nil pointer is
+// the zero style or link, which is what most cells have.
 type Cell struct {
 	// Content is the [Cell]'s content, which consists of a single grapheme
 	// cluster. Most of the time, this will be a single rune as well, but it
 	// can also be a combination of runes that form a grapheme cluster.
 	Content string
 
-	// The style of the cell. Nil style means no style. Zero value prints a
-	// reset sequence.
-	Style Style
+	// The style of the cell, shared with every cell that has the same one. A
+	// nil style means no style. Zero value prints a reset sequence.
+	Style *Style
 
-	// Link is the hyperlink of the cell.
-	Link Link
+	// Link is the hyperlink of the cell, shared like [Cell.Style].
+	Link *Link
 
 	// Width is the mono-spaced width of the grapheme cluster.
 	Width int
 }
 
+// StyleRef returns the style record for a cell: nil for the zero style, so a
+// cell with no style stays the zero [Cell], and a fresh record otherwise.
+// Cells that have the same style can share one record.
+func StyleRef(style Style) *Style {
+	if style.IsZero() {
+		return nil
+	}
+	return &style
+}
+
+// LinkRef returns the link record for a cell, like [StyleRef].
+func LinkRef(link Link) *Link {
+	if link.IsZero() {
+		return nil
+	}
+	return &link
+}
+
+// styleValue is the style a cell holds, with a nil style as the zero one.
+func styleValue(style *Style) Style {
+	if style == nil {
+		return Style{}
+	}
+	return *style
+}
+
+// linkValue is the link a cell holds, with a nil link as the zero one.
+func linkValue(link *Link) Link {
+	if link == nil {
+		return Link{}
+	}
+	return *link
+}
+
