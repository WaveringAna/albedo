 	// Start the renderer.
 	p.renderer.start()
+	p.requestFrame() // paint whatever was rendered while stopped
 	go func() {
+		pace := time.NewTimer(framerate)
+		pace.Stop()
+		var last time.Time
 		for {
 			select {
