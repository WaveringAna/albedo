+		for _, mime := range mimeTypes {
+			if mimeType == mime {
+				matched = append(matched, e.resolve())
+				break
+			}
+		}
+	}
+	others(func(lexer chroma.Lexer) {
+		for _, mime := range lexer.Config().MimeTypes {
+			if mimeType == mime {
+				matched = append(matched, lexer)
+				break
+			}
+		}
+	})
+	if len(matched) == 0 {
+		return nil
+	}
+	sort.Sort(matched)
+	return matched[0]
 }
 
