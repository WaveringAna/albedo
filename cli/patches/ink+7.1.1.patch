+// Wrapping and measurement see a new string on every streamed frame. Retain
+// nearby frames only, bounded by both entry count and UTF-16 storage units.
+export default class TextCache {
+    entries = new Map();
+    units = 0;
+    constructor(maxUnits = 65536, maxEntries = 128) {
+        this.maxUnits = maxUnits;
+        this.maxEntries = maxEntries;
+    }
+    get(key) {
+        const entry = this.entries.get(key);
+        if (entry === undefined) return undefined;
+        this.entries.delete(key);
+        this.entries.set(key, entry);
+        return entry.value;
+    }
+    set(key, value) {
+        const old = this.entries.get(key);
+        if (old !== undefined) { this.units -= old.units; this.entries.delete(key); }
+        const units = key.length + (typeof value === 'string' ? value.length : 0) + 1;
+        if (units > this.maxUnits) return;
+        this.entries.set(key, { value, units });
+        this.units += units;
+        while (this.units > this.maxUnits || this.entries.size > this.maxEntries) {
+            const first = this.entries.keys().next().value;
+            this.units -= this.entries.get(first).units;
+            this.entries.delete(first);
+        }
+    }
+}
