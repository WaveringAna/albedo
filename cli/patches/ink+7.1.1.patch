--- /dev/null
+++ b/node_modules/ink/build/styled-runs.js
@@ -0,0 +1,21 @@
+// Style transitions belong to runs, not individual terminal cells. Keep distinct
+// style objects conservative: identity equality proves the transition is a no-op.
+const sameStyles = (left, right) => left.length === right.length &&
+    left.every((code, index) => code === right[index]);
+export function styledRuns(characters) {
+    const runs = [];
+    let run;
+    const values = [];
+    for (const character of characters) {
+        if (character === undefined) continue;
+        if (!run || !sameStyles(run.styles, character.styles)) {
+            if (run) run.value = values.join('');
+            run = { ...character };
+            runs.push(run);
+            values.length = 0;
+        }
+        values.push(character.value);
+    }
+    if (run) run.value = values.join('');
+    return runs;
+}
