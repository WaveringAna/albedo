+// A render deadline must not move when another input event arrives. The compat
+// debounce throttle only checks maxWait on the next call, losing frame cadence.
+export function frameThrottle(render, interval) {
+    let last = -Infinity;
+    let timer;
+    let pending = false;
+    const invoke = () => {
+        if (timer !== undefined) clearTimeout(timer);
+        timer = undefined;
+        if (!pending) return;
+        pending = false;
+        last = performance.now();
+        render();
+    };
+    const schedule = () => {
+        pending = true;
+        const remaining = interval - (performance.now() - last);
+        if (remaining <= 0) invoke();
+        else if (timer === undefined) timer = setTimeout(invoke, Math.ceil(remaining));
+    };
+    schedule.flush = invoke;
+    schedule.cancel = () => {
+        if (timer !== undefined) clearTimeout(timer);
+        timer = undefined;
+        pending = false;
+        last = -Infinity;
+    };
+    return schedule;
+}
