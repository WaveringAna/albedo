    "highlight.js": "^11.11.1",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "@lezer/common": "^1.5.1",
    "@lezer/python": "^1.1.18",
    "@streamparser/json": "^0.0.22"
  },
  "devDependencies": {
    "@alcalzone/ansi-tokenize": "0.3.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.2",
